# Salin jadi .env.local (lokal) atau isi di Vercel > Project > Settings > Environment Variables

# Postgres gratis (Supabase / Neon). Kosongkan saat tes lokal -> pakai penyimpanan memori sementara.
DATABASE_URL=

# String acak panjang untuk menandatangani sesi login (minimal 32 karakter).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
